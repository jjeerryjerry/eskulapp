<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup=false; wykluczenia bazy Room jako dodatkowe zabezpieczenie (backup w chmurze
     oraz transfer urzadzenie->urzadzenie) gdyby backup kiedys wlaczono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="eskulapp.db" />
        <exclude domain="database" path="eskulapp.db-wal" />
        <exclude domain="database" path="eskulapp.db-shm" />
        <!-- anonimowy install_id ocen (SPEC-OCENY): nowe urzadzenie = nowy glosujacy -->
        <exclude domain="sharedpref" path="eskulapp_install.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="eskulapp.db" />
        <exclude domain="database" path="eskulapp.db-wal" />
        <exclude domain="database" path="eskulapp.db-shm" />
        <exclude domain="sharedpref" path="eskulapp_install.xml" />
    </device-transfer>
</data-extraction-rules>
