default_platform(:ios)

# Podpis i wysylka na TestFlight kluczem App Store Connect API (.p8), bez hasla Apple ID.
# Certyfikaty i profile trzymane przez `match` w prywatnym repo (readonly na CI).

platform :ios do
  desc "Build + podpis + wysylka na TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      app_identifier: "pl.eskulapp.mobile",
      readonly: true,
      api_key: api_key
    )

    increment_build_number(
      xcodeproj: "Eskulapp.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1"
    )

    build_app(
      project: "Eskulapp.xcodeproj",
      scheme: "Eskulapp",
      export_method: "app-store",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
