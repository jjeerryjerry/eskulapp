# Eskulapp — sekrety agenta (skopiuj do .env, chmod 600, NIE commituj)

# --- Backend web (deploy) ---
DEPLOY_SSH_HOST=edu-serwer          # ~/.ssh/config -> s18.cyber-folks.pl:222
DEPLOY_DOMAIN=eskulapp.pl            # domena produkcyjna (kupiona, podpięta)
DEPLOY_DOCROOT=/home/jjeerry/domains/eskulapp.pl/public_html
# Kod aplikacji + serwerowy .env lądują w  <DOCROOT>/../app  (poza webrootem).

# --- Baza MySQL (cyber-folks) ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# --- JWT ---
JWT_SECRET=                           # długi losowy sekret (dev); produkcja osobno
JWT_ACCESS_TTL=900                    # 15 min
JWT_REFRESH_TTL=2592000               # 30 dni

# --- Podpis Androida (upload key do Google Play) ---
ANDROID_KEYSTORE_PASS=
ANDROID_KEY_ALIAS=eskulapp
ANDROID_KEY_PASS=

# --- Google Play automatyczna publikacja (service account) ---
PLAY_SERVICE_ACCOUNT_JSON=/home/jjeerry/agents/eskulapp/.secrets/play-service-account.json
PLAY_PACKAGE=pl.eskulapp.mobile

# --- Oceny prelekcji (SPEC-OCENY) ---
# Na SERWERZE w web/cms/_app/.env (nie tutaj). Sol do hashowania install_id:
# sha256(install_id + RATING_SALT). Min. 16 znakow, np. `openssl rand -hex 32`.
# Nie zmieniaj po starcie ocen (inaczej ten sam telefon = nowy glosujacy).
RATING_SALT=
# Opcjonalnie: limity glosow na 10 min (domyslnie IP 600, urzadzenie 30).
# RATING_RL_IP_MAX=600
# RATING_RL_VOTER_MAX=30
